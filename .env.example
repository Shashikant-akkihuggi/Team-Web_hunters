# Database (PostgreSQL with pgvector or fallback SQLite)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/knowledge_continuity
# SQLite Fallback: sqlite:///./knowledge_continuity.db

# JWT Security
JWT_SECRET=super-secret-knowledge-continuity-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Application
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
